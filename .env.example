MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=chamber_scribe
SCRAPE_INTERVAL_SECONDS=3600
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Optional — how many times the downloader/transcriber retry a job before
# giving up (default 3 if unset). Also controls when the scraper re-queues
# a permanently-failed job on rediscovery.
JOB_MAX_RETRIES=3
